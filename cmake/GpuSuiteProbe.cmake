include(CMakeParseArguments)
include(CMakePushCheckState)
include(CheckCSourceCompiles)
include(CheckCXXSourceCompiles)
include(CheckSourceCompiles)

macro(_gpu_suite_prepare_probe prefix)
  cmake_push_check_state(RESET)
  set(CMAKE_REQUIRED_QUIET TRUE)
  set(CMAKE_REQUIRED_INCLUDES "${${prefix}_INCLUDES}")
  set(CMAKE_REQUIRED_LIBRARIES "${${prefix}_LIBRARIES}")
  set(CMAKE_REQUIRED_DEFINITIONS "${${prefix}_DEFINITIONS}")
  set(CMAKE_REQUIRED_LINK_OPTIONS "${${prefix}_LINK_OPTIONS}")
  if(${prefix}_COMPILE_OPTIONS)
    list(JOIN ${prefix}_COMPILE_OPTIONS " " _required_flags)
    set(CMAKE_REQUIRED_FLAGS "${_required_flags}")
  endif()
endmacro()

function(gpu_suite_check_c_link result)
  cmake_parse_arguments(PARSE_ARGV 1 PROBE "" "SOURCE"
    "INCLUDES;LIBRARIES;DEFINITIONS;COMPILE_OPTIONS;LINK_OPTIONS")
  if(NOT DEFINED PROBE_SOURCE)
    message(FATAL_ERROR "gpu_suite_check_c_link requires SOURCE")
  endif()
  _gpu_suite_prepare_probe(PROBE)
  unset(${result} CACHE)
  unset(${result})
  check_c_source_compiles("${PROBE_SOURCE}" ${result})
  set(${result} "${${result}}" PARENT_SCOPE)
  cmake_pop_check_state()
endfunction()

# Compile the real canonical HIP wrapper and an OpenMP C++ caller together.
# PROJECT-form try_compile permits an explicit CXX final link driver on CMake
# 3.21+, whereas two independent single-source checks cannot prove this link.
function(gpu_suite_check_rocthrust_openmp_link result)
  if(NOT CMAKE_HIP_COMPILER_LOADED)
    set(${result} FALSE PARENT_SCOPE)
    return()
  endif()
  cmake_parse_arguments(PARSE_ARGV 1 PROBE "" "SOURCE;WRAPPER"
    "COMPILE_OPTIONS;LINK_OPTIONS")
  if(NOT DEFINED PROBE_SOURCE OR NOT EXISTS "${PROBE_WRAPPER}")
    message(FATAL_ERROR "rocThrust interoperation probe requires SOURCE and an existing WRAPPER")
  endif()
  set(_probe_root "${CMAKE_BINARY_DIR}/CMakeFiles/${result}")
  set(_module_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  file(MAKE_DIRECTORY "${_probe_root}/source")
  file(WRITE "${_probe_root}/source/caller.cpp" "${PROBE_SOURCE}")
  set(_project [=[
cmake_minimum_required(VERSION 3.21)
project(GpuSuiteRocThrustInterop LANGUAGES CXX HIP)
list(APPEND CMAKE_MODULE_PATH [==[@_module_dir@]==])
# Recreate the real imported targets using the already-resolved paths. Do not
# rediscover a different SDK or approximate their usage requirements.
set(RocThrust_INCLUDE_DIR [==[@RocThrust_INCLUDE_DIR@]==] CACHE PATH "" FORCE)
set(RocThrust_ROCPRIM_INCLUDE_DIR [==[@RocThrust_ROCPRIM_INCLUDE_DIR@]==] CACHE PATH "" FORCE)
set(RocThrust_HIP_INCLUDE_DIR [==[@RocThrust_HIP_INCLUDE_DIR@]==] CACHE PATH "" FORCE)
set(RocThrust_HIP_LIBRARY [==[@RocThrust_HIP_LIBRARY@]==] CACHE FILEPATH "" FORCE)
find_package(RocThrust REQUIRED)
add_library(interop_wrapper OBJECT [==[@PROBE_WRAPPER@]==])
set_source_files_properties([==[@PROBE_WRAPPER@]==] PROPERTIES LANGUAGE HIP)
set_target_properties(interop_wrapper PROPERTIES HIP_STANDARD 17 HIP_STANDARD_REQUIRED YES HIP_EXTENSIONS NO)
target_link_libraries(interop_wrapper PRIVATE RocThrust::rocthrust RocThrust::hip)
add_executable(interop_probe caller.cpp)
set_target_properties(interop_probe PROPERTIES LINKER_LANGUAGE CXX CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
target_link_libraries(interop_probe PRIVATE interop_wrapper RocThrust::rocthrust RocThrust::hip)
set(_caller_compile [==[@PROBE_COMPILE_OPTIONS@]==])
set(_caller_link [==[@PROBE_LINK_OPTIONS@]==])
target_compile_options(interop_probe PRIVATE ${_caller_compile})
target_link_options(interop_probe PRIVATE ${_caller_link})
]=])
  string(CONFIGURE "${_project}" _project @ONLY)
  file(WRITE "${_probe_root}/source/CMakeLists.txt" "${_project}")
  set(_flags "")
  foreach(_variable CMAKE_CXX_COMPILER CMAKE_HIP_COMPILER CMAKE_HIP_ARCHITECTURES
      CMAKE_HIP_PLATFORM CMAKE_HIP_COMPILER_ROCM_ROOT CMAKE_HIP_COMPILER_ROCM_LIB
      CMAKE_TOOLCHAIN_FILE CMAKE_SYSROOT CMAKE_BUILD_TYPE
      CMAKE_CXX_FLAGS CMAKE_HIP_FLAGS CMAKE_EXE_LINKER_FLAGS)
    if(DEFINED ${_variable})
      list(APPEND _flags "-D${_variable}:STRING=${${_variable}}")
    endif()
  endforeach()
  foreach(_configuration DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    foreach(_language CXX HIP EXE_LINKER)
      set(_variable "CMAKE_${_language}_FLAGS_${_configuration}")
      if(DEFINED ${_variable})
        list(APPEND _flags "-D${_variable}:STRING=${${_variable}}")
      endif()
    endforeach()
  endforeach()
  unset(${result} CACHE)
  unset(${result})
  try_compile(${result} "${_probe_root}/build" "${_probe_root}/source"
    GpuSuiteRocThrustInterop interop_probe CMAKE_FLAGS ${_flags}
    OUTPUT_VARIABLE _output)
  file(WRITE "${_probe_root}/output.log" "${_output}")
  set(${result} "${${result}}" PARENT_SCOPE)
endfunction()

