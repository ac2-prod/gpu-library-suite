function(gpu_suite_record_status label enabled reason)
  if(enabled)
    set(_state "ENABLED")
  else()
    set(_state "DISABLED")
  endif()
  # A dependency failure may contain a semicolon; keep it in one list entry.
  string(REPLACE ";" "\\;" _line "${label}|${_state}|${reason}")
  set_property(GLOBAL APPEND PROPERTY GPU_SUITE_STATUS_LINES "${_line}")
endfunction()

function(gpu_suite_print_status)
  get_property(_lines GLOBAL PROPERTY GPU_SUITE_STATUS_LINES)
  message(STATUS "")
  message(STATUS "GPU Library Suite configure summary")
  message(STATUS "-----------------------------------")
  foreach(_line IN LISTS _lines)
    if(NOT _line MATCHES "^([^|]*)\\|([^|]*)\\|(.*)$")
      message(FATAL_ERROR "Invalid configure status entry: ${_line}")
    endif()
    set(_label "${CMAKE_MATCH_1}")
    set(_state "${CMAKE_MATCH_2}")
    set(_reason "${CMAKE_MATCH_3}")
    if("${_reason}" STREQUAL "")
      message(STATUS "${_label}: ${_state}")
    else()
      message(STATUS "${_label}: ${_state} (${_reason})")
    endif()
  endforeach()
  message(STATUS "")
endfunction()
