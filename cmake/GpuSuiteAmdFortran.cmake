# AMD Fortran discovery. CPU-only configuration never probes ROCm or a GPU.
include(GpuSuiteCpuDependencies)
include(CheckLanguage)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(GPU_SUITE_ROCM_ROOT "" CACHE PATH "Externally selected ROCm prefix")
set(GPU_SUITE_AMD_GPU_TARGET "" CACHE STRING "Explicit AMD OpenMP GPU target")
set(GPU_SUITE_HIP_TARGETS_ENABLED FALSE)
set(GPU_SUITE_OPENMP_TARGETS_ENABLED FALSE)
set(GPU_SUITE_HIP_DISABLE_REASON "not requested")
set(GPU_SUITE_OPENMP_DISABLE_REASON "not requested")
set(GPU_SUITE_OPENMP_COMPILE_OPTIONS "")
set(GPU_SUITE_OPENMP_LINK_OPTIONS "")
set(GPU_SUITE_FORTRAN_HIP_WRAPPER_ENABLED FALSE)
if(GPU_SUITE_BUILD_CPU)
  if("rocfft" IN_LIST GPU_SUITE_AMD_LIBRARIES)
    find_package(FFTW3f QUIET)
    find_path(GPU_SUITE_FORTRAN_FFTW_INCLUDE NAMES fftw3.f03
      HINTS "${FFTW3f_INCLUDE_DIR}" "${FFTW_ROOT}" ENV FFTW_ROOT PATH_SUFFIXES include)
  endif()
  if("rocblas" IN_LIST GPU_SUITE_AMD_LIBRARIES)
    gpu_suite_find_cblas()
  endif()
  if("rocsolver" IN_LIST GPU_SUITE_AMD_LIBRARIES)
    gpu_suite_find_lapacke()
  endif()
  if("rocsparse" IN_LIST GPU_SUITE_AMD_LIBRARIES)
    gpu_suite_find_aocl_sparse()
  endif()
endif()

if(GPU_SUITE_BUILD_HIP OR GPU_SUITE_BUILD_OPENMP)
  # .mod files are compiler-specific. The complete examples are compile/link
  # checked later with the selected compiler; a pathname alone is not proof.
  find_path(GPU_SUITE_HIPFORT_MODULE_DIR NAMES hipfort.mod
    HINTS ENV HIPFORT_MOD_DIR "${GPU_SUITE_ROCM_ROOT}"
    PATH_SUFFIXES include/hipfort/amdgcn include/hipfort include)
  find_library(GPU_SUITE_HIPFORT_LIBRARY NAMES hipfort-amdgcn
    HINTS ENV HIPFORT_ROOT "${GPU_SUITE_ROCM_ROOT}" PATH_SUFFIXES lib lib64)
  foreach(_package RocFFT RocBLAS RocSPARSE RocSOLVER RocRAND RocThrust)
    string(TOLOWER "${_package}" _library)
    if(_library IN_LIST GPU_SUITE_AMD_LIBRARIES)
      find_package(${_package} QUIET)
    endif()
  endforeach()
  if(GPU_SUITE_HIPFORT_MODULE_DIR AND GPU_SUITE_HIPFORT_LIBRARY)
    add_library(GpuSuite::hipfort UNKNOWN IMPORTED)
    set_target_properties(GpuSuite::hipfort PROPERTIES
      IMPORTED_LOCATION "${GPU_SUITE_HIPFORT_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${GPU_SUITE_HIPFORT_MODULE_DIR}")
    if(GPU_SUITE_BUILD_HIP)
      set(GPU_SUITE_HIP_TARGETS_ENABLED TRUE)
      set(GPU_SUITE_HIP_DISABLE_REASON "")
    endif()
    if(GPU_SUITE_BUILD_OPENMP)
      if(NOT GPU_SUITE_AMD_GPU_TARGET MATCHES "^gfx[0-9a-z]+(:[a-z0-9]+[+-])*$")
        set(GPU_SUITE_OPENMP_DISABLE_REASON "supply explicit GPU_SUITE_AMD_GPU_TARGET")
      elseif(NOT CMAKE_Fortran_COMPILER_ID MATCHES "^(LLVMFlang|Flang)$")
        set(GPU_SUITE_OPENMP_DISABLE_REASON "AMD OpenMP target requires an AMD LLVM Flang toolchain")
      else()
        set(GPU_SUITE_OPENMP_COMPILE_OPTIONS "-fopenmp;--offload-arch=${GPU_SUITE_AMD_GPU_TARGET}")
        set(GPU_SUITE_OPENMP_LINK_OPTIONS "${GPU_SUITE_OPENMP_COMPILE_OPTIONS}")
        set(GPU_SUITE_OPENMP_TARGETS_ENABLED TRUE)
        set(GPU_SUITE_OPENMP_DISABLE_REASON "")
      endif()
    endif()
  else()
    set(GPU_SUITE_HIP_DISABLE_REASON "hipFORT .mod directory and hipfort-amdgcn library are required")
    set(GPU_SUITE_OPENMP_DISABLE_REASON "${GPU_SUITE_HIP_DISABLE_REASON}")
  endif()
  # Only rocThrust's C++ interop object needs native HIP compilation.
  if(RocThrust_FOUND AND TARGET GpuSuite::hipfort)
    if(CMAKE_HIP_COMPILER MATCHES "(^|/)hipcc([^/]*)$")
      message(FATAL_ERROR "Native CMake HIP requires Clang, not the hipcc wrapper")
    endif()
    # Match the real Fortran link driver in the mixed-language try_compile.
    if(NOT CMAKE_VERSION VERSION_LESS 3.29 AND CMAKE_HIP_ARCHITECTURES
       AND NOT "native" IN_LIST CMAKE_HIP_ARCHITECTURES)
      check_language(HIP)
      if(CMAKE_HIP_COMPILER)
        enable_language(HIP)
        set(CMAKE_HIP_STANDARD 17)
        set(CMAKE_HIP_STANDARD_REQUIRED ON)
        set(_hip_flags "${CMAKE_HIP_FLAGS} ${CMAKE_HIP_FLAGS_RELEASE} ${CMAKE_HIP_FLAGS_RELWITHDEBINFO} ${CMAKE_HIP_FLAGS_MINSIZEREL} ${CMAKE_HIP_FLAGS_DEBUG}")
        if(_hip_flags MATCHES "(^| )(-Ofast|-ffast-math|-fassociative-math|-ffinite-math-only|-funsafe-math-optimizations)( |$)")
          message(FATAL_ERROR "Unapproved numerical flags in Fortran rocThrust HIP wrapper: ${_hip_flags}")
        endif()
        if(CMAKE_HIP_COMPILER_ID STREQUAL "Clang")
          set(GPU_SUITE_FORTRAN_HIP_WRAPPER_ENABLED TRUE)
        endif()
      endif()
    endif()
  endif()
endif()
