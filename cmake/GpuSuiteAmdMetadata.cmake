# Called only for the AMD family. The legacy NVIDIA JSON serialization and
# therefore its metadata/hash contract remain unchanged.
macro(gpu_suite_prepare_amd_metadata)
  set(_amd_hip_include "")
  foreach(_package RocFFT RocBLAS RocSPARSE RocSOLVER RocRAND RocThrust)
    if(${_package}_FOUND AND ${_package}_HIP_INCLUDE_DIR)
      file(REAL_PATH "${${_package}_HIP_INCLUDE_DIR}" _candidate_hip_include)
      if(_amd_hip_include AND NOT _amd_hip_include STREQUAL _candidate_hip_include)
        message(FATAL_ERROR "AMD libraries use different HIP header directories")
      endif()
      set(_amd_hip_include "${_candidate_hip_include}")
    endif()
  endforeach()
  set(_hip_config_flags_variable "CMAKE_HIP_FLAGS_${_build_type_upper}")
  set(_hip_flags "${CMAKE_HIP_FLAGS} ${${_hip_config_flags_variable}}")
  if(CMAKE_HIP_ARCHITECTURES)
    string(APPEND _hip_flags " CMAKE_HIP_ARCHITECTURES=${CMAKE_HIP_ARCHITECTURES}")
  endif()
  set(_openmp_compile_flags "${_cxx_flags} ${GPU_SUITE_OPENMP_COMPILE_OPTIONS}")
  set(_openmp_link_flags "${_link_flags} ${GPU_SUITE_OPENMP_LINK_OPTIONS}")
  if(GPU_SUITE_SOURCE_LANGUAGE STREQUAL "fortran")
    set(_amd_fortran_flags "${CMAKE_Fortran_FLAGS} ${CMAKE_Fortran_FLAGS_${_build_type_upper}} ${GPU_SUITE_FORTRAN_SAFE_OPTIONS}")
    set(_openmp_compile_flags "${_amd_fortran_flags} ${GPU_SUITE_OPENMP_COMPILE_OPTIONS}")
    set(_openmp_link_flags "${_amd_fortran_flags} ${_link_flags} ${GPU_SUITE_OPENMP_LINK_OPTIONS}")
  endif()
  foreach(_flags hip_flags openmp_compile_flags openmp_link_flags)
    string(REPLACE ";" " " _${_flags} "${_${_flags}}")
    string(STRIP "${_${_flags}}" _${_flags})
  endforeach()
  foreach(_pair
      "HIP_COMPILER_ID|${CMAKE_HIP_COMPILER_ID}"
      "HIP_COMPILER_VERSION|${CMAKE_HIP_COMPILER_VERSION}"
      "HIP_FLAGS|${_hip_flags}"
      "OPENMP_COMPILE_FLAGS|${_openmp_compile_flags}"
      "OPENMP_LINK_FLAGS|${_openmp_link_flags}"
      "ROCM_ROOT|${GPU_SUITE_ROCM_ROOT}"
      "AMD_GPU_TARGET|${GPU_SUITE_AMD_GPU_TARGET}"
      "C_COMPILER_PATH|${CMAKE_C_COMPILER}"
      "CXX_COMPILER_PATH|${CMAKE_CXX_COMPILER}"
      "HIP_COMPILER_PATH|${CMAKE_HIP_COMPILER}"
      "HIP_ARCHITECTURES|${CMAKE_HIP_ARCHITECTURES}"
      "ROCFFT_INCLUDE|${RocFFT_INCLUDE_DIR}"
      "HIP_INCLUDE|${_amd_hip_include}")
    string(FIND "${_pair}" "|" _separator)
    string(SUBSTRING "${_pair}" 0 ${_separator} _key)
    math(EXPR _start "${_separator} + 1")
    string(SUBSTRING "${_pair}" ${_start} -1 _value)
    _gpu_suite_escape_c_string("${_value}" GPU_SUITE_META_${_key})
    _gpu_suite_escape_json_string("${_value}" GPU_SUITE_META_${_key}_JSON)
  endforeach()
  set(GPU_SUITE_META_DEPENDENCIES_JSON "{")
  set(_dependency_separator "")
  set(_fftw_dependency_pairs "")
  if(GPU_SUITE_SOURCE_LANGUAGE STREQUAL "fortran")
    if(GPU_SUITE_HIPFORT_LIBRARY)
      list(APPEND _fftw_dependency_pairs "hipfort|${GPU_SUITE_HIPFORT_LIBRARY}")
    endif()
    foreach(_module hipfort hipfort_types hipfort_rocfft hipfort_rocblas
        hipfort_rocsolver hipfort_rocrand)
      if(GPU_SUITE_HIPFORT_MODULE_DIR)
        list(APPEND _fftw_dependency_pairs
          "${_module}_module|${GPU_SUITE_HIPFORT_MODULE_DIR}/${_module}.mod")
      endif()
    endforeach()
  endif()
  if(FFTW3f_FOUND)
    list(APPEND _fftw_dependency_pairs "fftw3f|${FFTW3f_LIBRARY}")
  endif()
  if(FFTW3f_THREAD_BACKEND STREQUAL "pthread" OR FFTW3f_THREAD_BACKEND STREQUAL "combined")
    set(_runtime_index 0)
    foreach(_runtime IN LISTS FFTW3f_THREAD_PTHREAD_RUNTIME_LIBRARIES)
      list(APPEND _fftw_dependency_pairs "fftw_pthread_runtime_${_runtime_index}|${_runtime}")
      math(EXPR _runtime_index "${_runtime_index} + 1")
    endforeach()
  endif()
  if(FFTW3f_THREAD_BACKEND STREQUAL "pthread")
    list(APPEND _fftw_dependency_pairs "fftw3f_threads|${FFTW3f_THREADS_LIBRARY}")
  elseif(FFTW3f_THREAD_BACKEND STREQUAL "openmp")
    list(APPEND _fftw_dependency_pairs "fftw3f_omp|${FFTW3f_OPENMP_LIBRARY}")
    set(_runtime_index 0)
    foreach(_runtime IN LISTS FFTW3f_THREAD_RUNTIME_LIBRARIES)
      list(APPEND _fftw_dependency_pairs "fftw_openmp_runtime_${_runtime_index}|${_runtime}")
      math(EXPR _runtime_index "${_runtime_index} + 1")
    endforeach()
  endif()
  if(RocFFT_FOUND)
    list(APPEND _fftw_dependency_pairs "hip|${RocFFT_HIP_LIBRARY}" "rocfft|${RocFFT_LIBRARY}")
  endif()
  foreach(_package RocBLAS RocSPARSE RocSOLVER RocRAND RocThrust)
    if(${_package}_FOUND)
      string(TOLOWER "${_package}" _dependency)
      if(_package STREQUAL RocThrust)
        list(APPEND _fftw_dependency_pairs
          "rocthrust|${RocThrust_INCLUDE_DIR}/thrust/version.h"
          "rocprim|${RocThrust_ROCPRIM_INCLUDE_DIR}/rocprim/rocprim.hpp")
      else()
        list(APPEND _fftw_dependency_pairs "${_dependency}|${${_package}_LIBRARY}")
      endif()
      list(APPEND _fftw_dependency_pairs "hip|${${_package}_HIP_LIBRARY}")
    endif()
  endforeach()
  foreach(_pair "CBLAS|cblas" "LAPACKE|lapacke" "MKLSparse|mkl_sparse" "AOCLSparse|aocl_sparse")
    string(REPLACE "|" ";" _fields "${_pair}")
    list(GET _fields 0 _target)
    list(GET _fields 1 _dependency)
    if(TARGET GpuSuite::${_target})
      get_target_property(_provider_libraries GpuSuite::${_target} INTERFACE_LINK_LIBRARIES)
      list(GET _provider_libraries 0 _provider_library)
      list(APPEND _fftw_dependency_pairs "${_dependency}|${_provider_library}")
      # Preserve the primary dependency name; additional absolute inputs are
      # identified by their position in the complete ordered link interface.
      set(_provider_link_index 0)
      foreach(_provider_library IN LISTS _provider_libraries)
        if(_provider_link_index GREATER 0 AND IS_ABSOLUTE "${_provider_library}")
          list(APPEND _fftw_dependency_pairs
            "${_dependency}_link_${_provider_link_index}|${_provider_library}")
        endif()
        math(EXPR _provider_link_index "${_provider_link_index} + 1")
      endforeach()
    endif()
  endforeach()
  if(TARGET GpuSuite::AOCLSparse)
    list(APPEND _fftw_dependency_pairs
      "aocl_sparse_header|${GPU_SUITE_AOCL_SPARSE_INCLUDE_DIR}/aoclsparse.h")
  endif()
  set(_openmp_runtime_index 0)
  foreach(_runtime IN LISTS OpenMP_CXX_LIBRARIES)
    if(IS_ABSOLUTE "${_runtime}")
      list(APPEND _fftw_dependency_pairs "cpu_openmp_runtime_${_openmp_runtime_index}|${_runtime}")
      math(EXPR _openmp_runtime_index "${_openmp_runtime_index} + 1")
    endif()
  endforeach()
  set(_recorded_dependency_names "")
  foreach(_pair IN LISTS _fftw_dependency_pairs)
    string(FIND "${_pair}" "|" _separator)
    string(SUBSTRING "${_pair}" 0 ${_separator} _key)
    math(EXPR _start "${_separator} + 1")
    string(SUBSTRING "${_pair}" ${_start} -1 _path)
    if(EXISTS "${_path}" AND NOT IS_DIRECTORY "${_path}")
      file(REAL_PATH "${_path}" _resolved)
      file(SHA256 "${_resolved}" _hash)
      if(_key IN_LIST _recorded_dependency_names)
        if(NOT "${_resolved}|${_hash}" STREQUAL "${_dependency_identity_${_key}}")
          message(FATAL_ERROR "AMD dependencies resolve to different files for ${_key}")
        endif()
        continue()
      endif()
      list(APPEND _recorded_dependency_names "${_key}")
      set(_dependency_identity_${_key} "${_resolved}|${_hash}")
      _gpu_suite_escape_json_string("${_resolved}" _path_json)
      string(APPEND GPU_SUITE_META_DEPENDENCIES_JSON
        "${_dependency_separator}\"${_key}\":{\"path\":\"${_path_json}\",\"sha256\":\"${_hash}\"}")
      set(_dependency_separator ",")
    endif()
  endforeach()
  string(APPEND GPU_SUITE_META_DEPENDENCIES_JSON "}")
  set(_fftw_requested "${FFTW3f_THREADING}")
  if(NOT _fftw_requested)
    set(_fftw_requested AUTO)
  endif()
  if(NOT _fftw_requested MATCHES "^(AUTO|PTHREAD|OPENMP|COMBINED|NONE)$")
    message(FATAL_ERROR "FFTW3f_THREADING must be AUTO, PTHREAD, OPENMP, COMBINED, or NONE")
  endif()
  set(_fftw_backend "${FFTW3f_THREAD_BACKEND}")
  if(NOT _fftw_backend)
    set(_fftw_backend none)
  endif()
  set(GPU_SUITE_META_FFTW_THREADING_JSON
    "{\"requested\":\"${_fftw_requested}\",\"backend\":\"${_fftw_backend}\"")
  foreach(_pair "compile_options|FFTW3f_THREAD_COMPILE_OPTIONS"
      "link_options|FFTW3f_THREAD_LINK_OPTIONS" "dependency_names|FFTW3f_THREAD_DEPENDENCY_NAMES")
    string(REPLACE "|" ";" _fields "${_pair}")
    list(GET _fields 0 _key)
    list(GET _fields 1 _variable)
    string(APPEND GPU_SUITE_META_FFTW_THREADING_JSON ",\"${_key}\":[")
    set(_option_separator "")
    foreach(_option IN LISTS ${_variable})
      _gpu_suite_escape_json_string("${_option}" _option_json)
      string(APPEND GPU_SUITE_META_FFTW_THREADING_JSON "${_option_separator}\"${_option_json}\"")
      set(_option_separator ",")
    endforeach()
    string(APPEND GPU_SUITE_META_FFTW_THREADING_JSON "]")
  endforeach()
  string(APPEND GPU_SUITE_META_FFTW_THREADING_JSON "}")
  # Bind target selection, provider choices, headers and target-specific input
  # flags even when they are not part of global compiler flags.
  set(GPU_SUITE_META_AMD_INPUTS_JSON "{")
  set(_input_separator "")
  foreach(_variable GPU_SUITE_AMD_LIBRARIES
      GPU_SUITE_CPU_BLAS_BACKEND GPU_SUITE_CPU_SPARSE_BACKEND
      GPU_SUITE_CPU_LAPACK_BACKEND GPU_SUITE_CPU_THRUST_BACKEND
      CMAKE_C_STANDARD CMAKE_CXX_STANDARD CMAKE_HIP_STANDARD OpenMP_CXX_FLAGS
      RocFFT_INCLUDE_DIR RocBLAS_INCLUDE_DIR RocSPARSE_INCLUDE_DIR
      RocSOLVER_INCLUDE_DIR RocRAND_INCLUDE_DIR RocThrust_INCLUDE_DIR
      RocThrust_ROCPRIM_INCLUDE_DIR)
    _gpu_suite_escape_json_string("${${_variable}}" _input_value)
    string(APPEND GPU_SUITE_META_AMD_INPUTS_JSON
      "${_input_separator}\"${_variable}\":\"${_input_value}\"")
    set(_input_separator ",")
  endforeach()
  foreach(_provider CBLAS LAPACKE MKLSparse AOCLSparse)
    if(TARGET GpuSuite::${_provider})
      foreach(_property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS
          INTERFACE_COMPILE_OPTIONS INTERFACE_LINK_OPTIONS INTERFACE_LINK_LIBRARIES)
        get_target_property(_provider_value GpuSuite::${_provider} ${_property})
        if(_provider_value STREQUAL "_provider_value-NOTFOUND")
          set(_provider_value "")
        endif()
        _gpu_suite_escape_json_string("${_provider_value}" _input_value)
        string(APPEND GPU_SUITE_META_AMD_INPUTS_JSON
          ",\"${_provider}_${_property}\":\"${_input_value}\"")
      endforeach()
    endif()
  endforeach()
  string(APPEND GPU_SUITE_META_AMD_INPUTS_JSON "}")
  set(GPU_SUITE_META_ROCTHRUST_INTEROP_JSON "null")
  if(GPU_SUITE_SOURCE_LANGUAGE STREQUAL "fortran" AND GPU_SUITE_FORTRAN_HIP_WRAPPER_ENABLED)
    set(_wrapper "amd/fortran/rocthrust/examples/rocthrust_wrapper.hip")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${_wrapper}")
    file(SHA256 "${CMAKE_SOURCE_DIR}/${_wrapper}" _wrapper_hash)
    _gpu_suite_escape_json_string("${CMAKE_Fortran_COMPILER}" _fortran_compiler_json)
    _gpu_suite_escape_json_string("${_amd_fortran_flags} ${GPU_SUITE_OPENMP_COMPILE_OPTIONS}" _fortran_flags_json)
    set(GPU_SUITE_META_ROCTHRUST_INTEROP_JSON
      "{\"source\":\"${_wrapper}\",\"source_sha256\":\"${_wrapper_hash}\",\"compiler_language\":\"hip\",\"compiler_path\":\"${GPU_SUITE_META_HIP_COMPILER_PATH_JSON}\",\"compile_flags\":\"${GPU_SUITE_META_HIP_FLAGS_JSON}\",\"caller_language\":\"fortran\",\"caller_compile_flags\":\"${_fortran_flags_json}\",\"linker_language\":\"fortran\",\"linker_path\":\"${_fortran_compiler_json}\",\"link_flags\":\"${_fortran_flags_json}\"}")
  endif()
  if(GPU_SUITE_ROCTHRUST_OPENMP_ENABLED)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
      "${CMAKE_SOURCE_DIR}/amd/c-cpp/rocthrust/examples/rocthrust_wrapper.hip")
    file(SHA256 "${CMAKE_SOURCE_DIR}/amd/c-cpp/rocthrust/examples/rocthrust_wrapper.hip" _wrapper_hash)
    set(GPU_SUITE_META_ROCTHRUST_INTEROP_JSON
      "{\"source\":\"amd/c-cpp/rocthrust/examples/rocthrust_wrapper.hip\",\"source_sha256\":\"${_wrapper_hash}\",\"compiler_language\":\"hip\",\"compiler_path\":\"${GPU_SUITE_META_HIP_COMPILER_PATH_JSON}\",\"compile_flags\":\"${GPU_SUITE_META_HIP_FLAGS_JSON}\",\"caller_language\":\"cxx\",\"caller_compile_flags\":\"${GPU_SUITE_META_OPENMP_COMPILE_FLAGS_JSON}\",\"linker_language\":\"cxx\",\"linker_path\":\"${GPU_SUITE_META_CXX_COMPILER_PATH_JSON}\",\"link_flags\":\"${GPU_SUITE_META_OPENMP_LINK_FLAGS_JSON}\"}")
  endif()
endmacro()
